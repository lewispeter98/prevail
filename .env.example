# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret key (sb_secret_...) or legacy service_role key. Server only.
SUPABASE_SECRET_KEY=

# The passcode you type once per device.
PREVAIL_PASSCODE=
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Phase 3 (AI reflections)
ANTHROPIC_API_KEY=
# Protects the weekly-review scheduled job. Any long random string.
CRON_SECRET=
